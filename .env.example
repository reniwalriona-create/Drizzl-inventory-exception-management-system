# Copy this file to .env and fill in real values for your environment.
# .env itself is gitignored and must never be committed -- this example
# file is the only one that belongs in version control.
#
# Local development doesn't strictly need a .env at all: config.py falls
# back to safe, clearly-labeled development defaults (a local Postgres
# database named drizzl_inventory, a fixed dev-only secret key) whenever
# APP_ENV is unset or not "production". Production refuses to start
# without SECRET_KEY and DATABASE_URL explicitly set -- see config.py.

# "production" enables production behavior: no debug mode, no insecure
# SECRET_KEY/DATABASE_URL fallbacks (both become required). Leave unset
# or set to "development" for local work.
APP_ENV=development

# A long, random, secret value used to sign session cookies and CSRF
# tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Required when APP_ENV=production. Never reuse a value you've ever
# committed or shared.
SECRET_KEY=

# A standard libpq connection string/DSN, e.g.:
#   postgresql://appuser:apppassword@localhost:5432/drizzl_inventory
# Required when APP_ENV=production. Local dev doesn't need this set --
# it falls back to `dbname=drizzl_inventory` (local trust/peer auth, no
# password), matching how this project has always run locally.
DATABASE_URL=

# Required in production. Comma-separated hostnames that may serve this app;
# do not include https:// or paths. Example: inventory.example.com
TRUSTED_HOSTS=

# Port the dev server (python app.py) listens on. Optional, defaults to
# 5001 (not 5000 -- macOS ControlCenter/AirPlay Receiver squats on 5000
# on some Macs). Not used when running under gunicorn -- pass gunicorn
# its own -b/--bind instead.
PORT=5001
